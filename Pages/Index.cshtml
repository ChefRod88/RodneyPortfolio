<!-- ═══ QUOTE FORM ═══ -->
<section id="quote" class="rc-fade">
    <p class="section__text__p1">Let's Build</p>
    <h1 class="title">Request a Quote</h1>

    <div class="rc-quote-grid">
        <div class="rc-quote-info">
            <h3 class="rc-quote-info-title">// What happens next</h3>
            <p>Fill out the form and I'll respond within 24 hours with a brief scope summary and a time to connect. No hard sell — just a real conversation about your project.</p>
            <p>Every project starts with a <span style="color:var(--c);">free 30-minute discovery call</span> where we define scope, timeline, and fit.</p>
            <ul class="rc-quote-promises">
                <li>Response within 24 hours</li>
                <li>Free discovery call — no commitment</li>
                <li>Written scope before any work begins</li>
                <li>Transparent pricing &amp; IP policies</li>
                <li>Ongoing managed support options</li>
            </ul>
        </div>

        <form id="quoteForm" class="rc-glass rc-quote-form" method="post" action="?handler=Quote" onsubmit="handleQuoteSubmit(event)">
            @Html.AntiForgeryToken()
            <div class="rc-form-row">
                <div class="rc-form-group">
                    <label class="rc-form-label">Your Name *</label>
                    <input type="text" name="Name" class="rc-form-input" placeholder="Jane Smith" required />
                </div>
                <div class="rc-form-group">
                    <label class="rc-form-label">Email *</label>
                    <input type="email" name="Email" class="rc-form-input" placeholder="jane@company.com" required />
                </div>
            </div>
            <div class="rc-form-group">
                <label class="rc-form-label">Company / Organization</label>
                <input type="text" name="Company" class="rc-form-input" placeholder="Acme Corp (optional)" />
            </div>
            <div class="rc-form-group">
                <label class="rc-form-label">Service Needed *</label>
                <select name="ServiceNeeded" class="rc-form-input rc-form-select" required>
                    <option value="" disabled selected>Select a service...</option>
                    <option>Starter Website</option>
                    <option>Business Website</option>
                    <option>Growth Website</option>
                    <option>Custom Business Application</option>
                    <option>Advanced Application / Portal</option>
                    <option>Healthcare / EMR Solution</option>
                    <option>AI &amp; Automation</option>
                    <option>API / Systems Integration</option>
                    <option>Cloud Infrastructure</option>
                    <option>Managed Application Services</option>
                    <option>SEO / Digital Marketing</option>
                    <option>Not Sure — Need Consultation</option>
                </select>
            </div>
            <div class="rc-form-group">
                <label class="rc-form-label">Estimated Implementation Budget *</label>
                <select name="EstimatedBudget" class="rc-form-input rc-form-select" required>
                    <option value="" disabled selected>Select a budget range...</option>
                    <option>Under $1,000</option>
                    <option>$1,000 – $2,500</option>
                    <option>$2,500 – $5,000</option>
                    <option>$5,000 – $10,000</option>
                    <option>$10,000 – $20,000</option>
                    <option>$20,000+</option>
                    <option>Not sure yet</option>
                </select>
            </div>
            <div class="rc-form-group">
                <label class="rc-form-label">Project Description *</label>
                <textarea name="ProjectDescription" class="rc-form-input rc-form-textarea" placeholder="Describe what you need built. What problem does it solve? What does success look like?" required></textarea>
            </div>
            <div class="rc-form-group">
                <label class="rc-form-label">Timeline</label>
                <select name="Timeline" class="rc-form-input rc-form-select">
                    <option value="" disabled selected>When do you need this?</option>
                    <option>ASAP (within 2 weeks)</option>
                    <option>1 month</option>
                    <option>2–3 months</option>
                    <option>Flexible</option>
                </select>
            </div>
            <div class="rc-form-group" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;" aria-hidden="true">
                <label class="rc-form-label" for="Website">Leave this field empty</label>
                <input id="Website" type="text" name="Website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="rc-form-group">
                <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
            </div>
            <button type="submit" class="btn btn-outline-dark rc-quote-submit">Submit Request →</button>
            <div id="quoteError" style="display:none;text-align:center;padding:1rem;color:#ff9f9f;"></div>
            <div id="quoteSuccess" style="display:none;text-align:center;padding:2rem;">
                <div style="font-family:var(--font-display);font-size:1rem;color:var(--c);margin-bottom:0.5rem;">✓ Request Received</div>
                <div style="font-family:var(--font-mono);font-size:0.68rem;color:rgba(142,207,223,0.5);">I'll be in touch within 24 hours.</div>
            </div>
        </form>
    </div>
</section>

